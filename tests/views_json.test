<?php
/**
 * @file
 * Functional tests for the Views JSON module.
 */

/**
 * Test basic functionality.
 */
class ViewsJsonBasicTest extends BackdropWebTestCase {

  protected $profile = 'testing';
  const VIEWS_JSON_GROUP = 'Views JSON';

  /**
   * {@inheritdoc}
   */
  public function setUp() {
    parent::setUp('views_ui', 'views_json');

    // Dummy content 15 items so we can test pagers fully.
    //   NOTE: do not change the number of items without realising that this
    //         will affect full output tests!
    $type = $this->backdropCreateContentType();
    for ($i = 1; $i <= 15; $i++) {
      $this->backdropCreateNode(array(
        'title' => sprintf('Test content %d', $i),
        'type' => $type->type,
      ));
    }

    // Create and log in a user with administer views permission.
    $views_admin = $this->backdropCreateUser(array(
      'administer views',
      'access all views',
    ));
    $this->backdropLogin($views_admin);
    return TRUE;
  }

  /**
   * Check output from the default (simple) setting.
   */
  public function testJsonOutputDefault() {
    // Create the view.
    $view_name = strtolower($this->randomName(16));
    $path = $this->randomName(16);
    $view_form = array(
      'human_name' => $this->randomName(16),
      'name' => $view_name,
      'page[create]' => 1,
      'page[style][style_plugin]' =>'views_json',
      'page[path]' => $path,
    );
    $this->backdropPost('admin/structure/views/add', $view_form, t('Save view'));

    // Get the View object to alter settings.
    $view = views_get_view($view_name);

    // TEST the default settings.
    $this->backdropGet($path);
    $headers = $this->backdropGetHeaders();
    $this->assertEqual($headers['content-type'], 'application/json; charset=utf-8', 'JSON reponse content type.');
    $exptected_output = '{"nodes":[{"node":{"title":"Test content 15"}},{"node":{"title":"Test content 14"}},{"node":{"title":"Test content 13"}},{"node":{"title":"Test content 12"}},{"node":{"title":"Test content 11"}},{"node":{"title":"Test content 10"}},{"node":{"title":"Test content 9"}},{"node":{"title":"Test content 8"}},{"node":{"title":"Test content 7"}},{"node":{"title":"Test content 6"}}],"pager":{"pages":2,"page":0,"count":15,"limit":10}}';
    $this->assertEqual($this->backdropGetContent(), $exptected_output, 'JSON output for defaults.', self::VIEWS_JSON_GROUP);
    // Repeat the test for the second page.
    $this->backdropGet($path, array('query' => array('page' => 1)));
    $exptected_output = '{"nodes":[{"node":{"title":"Test content 5"}},{"node":{"title":"Test content 4"}},{"node":{"title":"Test content 3"}},{"node":{"title":"Test content 2"}},{"node":{"title":"Test content 1"}}],"pager":{"pages":2,"page":1,"count":15,"limit":10}}';
    $this->assertEqual($this->backdropGetContent(), $exptected_output, 'JSON output for defaults second page.', self::VIEWS_JSON_GROUP);

    // Add the "Nid" field.
    $view->display['default']->display_options['fields']['nid'] = array(
      'id' => 'nid',
      'table' => 'node',
      'field' => 'nid',
    );
    $view->save();

    // TEST with added "Nid" field.
    $this->backdropGet($path);
    $exptected_output = '{"nodes":[{"node":{"title":"Test content 15","Nid":"15"}},{"node":{"title":"Test content 14","Nid":"14"}},{"node":{"title":"Test content 13","Nid":"13"}},{"node":{"title":"Test content 12","Nid":"12"}},{"node":{"title":"Test content 11","Nid":"11"}},{"node":{"title":"Test content 10","Nid":"10"}},{"node":{"title":"Test content 9","Nid":"9"}},{"node":{"title":"Test content 8","Nid":"8"}},{"node":{"title":"Test content 7","Nid":"7"}},{"node":{"title":"Test content 6","Nid":"6"}}],"pager":{"pages":2,"page":0,"count":15,"limit":10}}';
    $this->assertEqual($this->backdropGetContent(), $exptected_output, 'JSON output for added Nid field.', self::VIEWS_JSON_GROUP);
    // Repeat the test for the second page.
    $this->backdropGet($path, array('query' => array('page' => 1)));
    $exptected_output = '{"nodes":[{"node":{"title":"Test content 5","Nid":"5"}},{"node":{"title":"Test content 4","Nid":"4"}},{"node":{"title":"Test content 3","Nid":"3"}},{"node":{"title":"Test content 2","Nid":"2"}},{"node":{"title":"Test content 1","Nid":"1"}}],"pager":{"pages":2,"page":1,"count":15,"limit":10}}';
    $this->assertEqual($this->backdropGetContent(), $exptected_output, 'JSON output for added Nid field second page.', self::VIEWS_JSON_GROUP);

    // Set the "numeric strings" option.
    $view->display['default']->display_options['style_options']['numeric_strings'] = TRUE;
    $view->save();

    // TEST with numeric strings.
    $this->backdropGet($path);
    $exptected_output = '{"nodes":[{"node":{"title":"Test content 15","Nid":15}},{"node":{"title":"Test content 14","Nid":14}},{"node":{"title":"Test content 13","Nid":13}},{"node":{"title":"Test content 12","Nid":12}},{"node":{"title":"Test content 11","Nid":11}},{"node":{"title":"Test content 10","Nid":10}},{"node":{"title":"Test content 9","Nid":9}},{"node":{"title":"Test content 8","Nid":8}},{"node":{"title":"Test content 7","Nid":7}},{"node":{"title":"Test content 6","Nid":6}}],"pager":{"pages":2,"page":0,"count":15,"limit":10}}';
    $this->assertEqual($this->backdropGetContent(), $exptected_output, 'JSON output for numeric strings setting.', self::VIEWS_JSON_GROUP);
    // Repeat the test for the second page.
    $this->backdropGet($path, array('query' => array('page' => 1)));
    $exptected_output = '{"nodes":[{"node":{"title":"Test content 5","Nid":5}},{"node":{"title":"Test content 4","Nid":4}},{"node":{"title":"Test content 3","Nid":3}},{"node":{"title":"Test content 2","Nid":2}},{"node":{"title":"Test content 1","Nid":1}}],"pager":{"pages":2,"page":1,"count":15,"limit":10}}';
    $this->assertEqual($this->backdropGetContent(), $exptected_output, 'JSON output for numeric strings setting second page.', self::VIEWS_JSON_GROUP);
  }

  /**
   * Check output from the simple setting with no pager info in JSON and all items, 
   */
  public function testJsonOutputDefaultNoPagerAllItems() {
    // Create the view.
    $view_name = strtolower($this->randomName(16));
    $path = $this->randomName(16);
    $view_form = array(
      'human_name' => $this->randomName(16),
      'name' => $view_name,
      'page[create]' => 1,
      'page[style][style_plugin]' =>'views_json',
      'page[path]' => $path,
      'page[pager]' => FALSE,
      'page[items_per_page]' => 0,
    );
    $this->backdropPost('admin/structure/views/add', $view_form, t('Save view'));

    // Get the View object to alter settings.
    $view = views_get_view($view_name);

    // Removing pager flips sort order - fix that for consistency.
    $view->display['default']->display_options['sorts'] = array('nid' => array(
      'id' => 'nid',
      'table' => 'node',
      'field' => 'nid',
      'order' => 'DESC'
    ));
    $view->save();

    // TEST the default settings.
    $this->backdropGet($path);
    $exptected_output = '{"nodes":[{"node":{"title":"Test content 15"}},{"node":{"title":"Test content 14"}},{"node":{"title":"Test content 13"}},{"node":{"title":"Test content 12"}},{"node":{"title":"Test content 11"}},{"node":{"title":"Test content 10"}},{"node":{"title":"Test content 9"}},{"node":{"title":"Test content 8"}},{"node":{"title":"Test content 7"}},{"node":{"title":"Test content 6"}},{"node":{"title":"Test content 5"}},{"node":{"title":"Test content 4"}},{"node":{"title":"Test content 3"}},{"node":{"title":"Test content 2"}},{"node":{"title":"Test content 1"}}]}';
    $this->assertEqual($this->backdropGetContent(), $exptected_output, 'JSON output for no pager with all items.', self::VIEWS_JSON_GROUP);

    // Add the "Nid" field.
    $view->display['default']->display_options['fields']['nid'] = array(
      'id' => 'nid',
      'table' => 'node',
      'field' => 'nid',
    );
    $view->save();

    // TEST with added "Nid" field.
    $this->backdropGet($path);
    $exptected_output = '{"nodes":[{"node":{"title":"Test content 15","Nid":"15"}},{"node":{"title":"Test content 14","Nid":"14"}},{"node":{"title":"Test content 13","Nid":"13"}},{"node":{"title":"Test content 12","Nid":"12"}},{"node":{"title":"Test content 11","Nid":"11"}},{"node":{"title":"Test content 10","Nid":"10"}},{"node":{"title":"Test content 9","Nid":"9"}},{"node":{"title":"Test content 8","Nid":"8"}},{"node":{"title":"Test content 7","Nid":"7"}},{"node":{"title":"Test content 6","Nid":"6"}},{"node":{"title":"Test content 5","Nid":"5"}},{"node":{"title":"Test content 4","Nid":"4"}},{"node":{"title":"Test content 3","Nid":"3"}},{"node":{"title":"Test content 2","Nid":"2"}},{"node":{"title":"Test content 1","Nid":"1"}}]}';
    $this->assertEqual($this->backdropGetContent(), $exptected_output, 'JSON output for added Nid field and no pager with all items.', self::VIEWS_JSON_GROUP);
    
    // Set the "numeric strings" option.
    $view->display['default']->display_options['style_options']['numeric_strings'] = TRUE;
    $view->save();

    // TEST with numeric strings.
    $this->backdropGet($path);
    $exptected_output = '{"nodes":[{"node":{"title":"Test content 15","Nid":15}},{"node":{"title":"Test content 14","Nid":14}},{"node":{"title":"Test content 13","Nid":13}},{"node":{"title":"Test content 12","Nid":12}},{"node":{"title":"Test content 11","Nid":11}},{"node":{"title":"Test content 10","Nid":10}},{"node":{"title":"Test content 9","Nid":9}},{"node":{"title":"Test content 8","Nid":8}},{"node":{"title":"Test content 7","Nid":7}},{"node":{"title":"Test content 6","Nid":6}},{"node":{"title":"Test content 5","Nid":5}},{"node":{"title":"Test content 4","Nid":4}},{"node":{"title":"Test content 3","Nid":3}},{"node":{"title":"Test content 2","Nid":2}},{"node":{"title":"Test content 1","Nid":1}}]}';
    $this->assertEqual($this->backdropGetContent(), $exptected_output, 'JSON output for numeric strings setting and no pager with all items.', self::VIEWS_JSON_GROUP);
  }

  /**
   * Check output from the MIT Simile/Exhibit setting.
   */
  public function testMitSimileExhibit() {
    // Create the view.
    $view_name = strtolower($this->randomName(16));
    $path = $this->randomName(16);
    $view_form = array(
      'human_name' => $this->randomName(16),
      'name' => $view_name,
      'page[create]' => 1,
      'page[style][style_plugin]' =>'views_json',
      'page[path]' => $path,
    );
    $this->backdropPost('admin/structure/views/add', $view_form, t('Save view'));

    // Get the View object to alter settings.
    $view = views_get_view($view_name);

    // Set the MIT Simile/Exhibit output option.
    $view->display['default']->display_options['style_options']['format'] = 'exhibit';
    $view->save();    

    // TEST the settings.
    $this->backdropGet($path);
    $exptected_output = '{"Items":[{"node":{"title":"Test content 15"},"label":"Item","type":"node"},{"node":{"title":"Test content 14"},"label":"Item","type":"node"},{"node":{"title":"Test content 13"},"label":"Item","type":"node"},{"node":{"title":"Test content 12"},"label":"Item","type":"node"},{"node":{"title":"Test content 11"},"label":"Item","type":"node"},{"node":{"title":"Test content 10"},"label":"Item","type":"node"},{"node":{"title":"Test content 9"},"label":"Item","type":"node"},{"node":{"title":"Test content 8"},"label":"Item","type":"node"},{"node":{"title":"Test content 7"},"label":"Item","type":"node"},{"node":{"title":"Test content 6"},"label":"Item","type":"node"}]}';
    $this->assertEqual($this->backdropGetContent(), $exptected_output, 'JSON output for MIT Simile/Exhibit.', self::VIEWS_JSON_GROUP);
  }

  /**
   * Check output from the simple object setting.
   */
  public function testJsonOutputSimpleObject() {
    // Create the view.
    $view_name = strtolower($this->randomName(16));
    $path = $this->randomName(16);
    $view_form = array(
      'human_name' => $this->randomName(16),
      'name' => $view_name,
      'page[create]' => 1,
      'page[style][style_plugin]' =>'views_json',
      'page[path]' => $path,
      'page[pager]' => FALSE,
      'page[items_per_page]' => 1,
    );
    $this->backdropPost('admin/structure/views/add', $view_form, t('Save view'));

    // Get the View object to alter settings.
    $view = views_get_view($view_name);

    // Set the simple object output option.
    $view->display['default']->display_options['style_options']['format'] = 'simple_object';
    $view->save();

    // TEST the simple object output.
    $this->backdropGet($path);
    $exptected_output = '{"title":"Test content 15"}';
    $this->assertEqual($this->backdropGetContent(), $exptected_output, 'JSON output for simple object.', self::VIEWS_JSON_GROUP);
  }

   /**
   * Check output from the simple object setting.
   */
  public function testJsonOutputJqGrid() {
    // Create the view.
    $view_name = strtolower($this->randomName(16));
    $path = $this->randomName(16);
    $view_form = array(
      'human_name' => $this->randomName(16),
      'name' => $view_name,
      'page[create]' => 1,
      'page[style][style_plugin]' =>'views_json',
      'page[path]' => $path,
    );
    $this->backdropPost('admin/structure/views/add', $view_form, t('Save view'));

    // Get the View object to alter settings.
    $view = views_get_view($view_name);

    // Set the jqGrid output option.
    $view->display['default']->display_options['style_options']['format'] = 'jqgrid';
    $view->save();

    // TEST the simple object output.
    $this->backdropGet($path);
    $exptected_output = '{"page":1,"records":"15","total":2,"rows":[{"title":"Test content 15"},{"title":"Test content 14"},{"title":"Test content 13"},{"title":"Test content 12"},{"title":"Test content 11"},{"title":"Test content 10"},{"title":"Test content 9"},{"title":"Test content 8"},{"title":"Test content 7"},{"title":"Test content 6"}]}';
    $this->assertEqual($this->backdropGetContent(), $exptected_output, 'JSON output for jqGrid.', self::VIEWS_JSON_GROUP);
  }

  /**
   * Check output from the Backdrop autocomplete setting.
   */
  public function testJsonOutputBackdropAutocomplete() {
    // Create the view.
    $view_name = strtolower($this->randomName(16));
    $path = $this->randomName(16);
    $view_form = array(
      'human_name' => $this->randomName(16),
      'name' => $view_name,
      'page[create]' => 1,
      'page[style][style_plugin]' =>'views_json',
      'page[path]' => $path,
    );
    $this->backdropPost('admin/structure/views/add', $view_form, t('Save view'));

    // Get the View object to alter settings.
    $view = views_get_view($view_name);

    // Set the jqGrid output option.
    $view->display['default']->display_options['style_options']['format'] = 'autocomplete';
    $view->save();

    // TEST the Backdrop autocomplete output.
    $this->backdropGet($path);
    $exptected_output = '{"Test content 15":"Test content 15","Test content 14":"Test content 14","Test content 13":"Test content 13","Test content 12":"Test content 12","Test content 11":"Test content 11","Test content 10":"Test content 10","Test content 9":"Test content 9","Test content 8":"Test content 8","Test content 7":"Test content 7","Test content 6":"Test content 6"}';
    $this->assertEqual($this->backdropGetContent(), $exptected_output, 'JSON output for Backdrop autocomplete.', self::VIEWS_JSON_GROUP);
  }

}
